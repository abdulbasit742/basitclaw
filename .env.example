PORT=3000
NODE_ENV=development
WORKFORCE_AUDIT_DATA_MODE=encrypted-file
WORKFORCE_AUDIT_DATA_DIR=.runtime-data/workforce-audit
WORKFORCE_AUDIT_BACKUP_DIR=.runtime-data/workforce-audit-backups
WORKFORCE_AUDIT_BACKUP_RETENTION=30
# Set this to a separately mounted durable volume in production.
# WORKFORCE_AUDIT_REPLICA_DIR=/mnt/off-host/workforce-audit-replicas
WORKFORCE_AUDIT_REPLICA_RETENTION=90
WORKFORCE_AUDIT_REPLICATION_REQUIRED=false
WORKFORCE_AUDIT_REPLICA_MAX_LAG_MINUTES=2880
# Zero disables the internal scheduler. A common production value is 1440.
WORKFORCE_AUDIT_SCHEDULED_BACKUP_MINUTES=0
WORKFORCE_AUDIT_DRILL_MAX_AGE_DAYS=30
WORKFORCE_AUDIT_SCHEDULER_TICK_SECONDS=60
# Enable file-lease only when all application processes share a filesystem with atomic mkdir/rename semantics.
WORKFORCE_AUDIT_COORDINATION_MODE=disabled
WORKFORCE_AUDIT_COORDINATION_DIR=.runtime-data/workforce-audit-coordination
WORKFORCE_AUDIT_FENCED_DATA_DIR=.runtime-data/workforce-audit-fenced
WORKFORCE_AUDIT_FENCED_VERSIONS=5
# Set a unique stable identifier per running process/container when coordination is enabled.
# WORKFORCE_AUDIT_INSTANCE_ID=basitclaw-node-1
WORKFORCE_AUDIT_LEASE_MS=30000
WORKFORCE_AUDIT_ACQUIRE_TIMEOUT_MS=1000
WORKFORCE_AUDIT_LEASE_RETRY_MS=20
AUDIT_PROVIDER_REVIEW_MAX_AGE_DAYS=365
# JSON array. Use long, randomly generated values outside local development.
WORKFORCE_AUDIT_API_KEYS=[{"apiKey":"local-development-key","subject":"local-admin","tenantId":"tenant-demo","role":"compliance_admin"}]
# JSON object mapping key IDs to base64-encoded 32-byte keys. Set this in production.
# WORKFORCE_AUDIT_ENCRYPTION_KEYS={"2026-q3":"<base64-32-byte-key>"}
# WORKFORCE_AUDIT_PRIMARY_KEY_ID=2026-q3
