PORT=3000
NODE_ENV=development
WORKFORCE_AUDIT_DATA_MODE=encrypted-file
WORKFORCE_AUDIT_DATA_DIR=.runtime-data/workforce-audit
WORKFORCE_AUDIT_BACKUP_DIR=.runtime-data/workforce-audit-backups
WORKFORCE_AUDIT_BACKUP_RETENTION=30
# Set this to a separately mounted durable volume in production.
# WORKFORCE_AUDIT_REPLICA_DIR=/mnt/off-host/workforce-audit-replicas
WORKFORCE_AUDIT_REPLICA_RETENTION=90
WORKFORCE_AUDIT_REPLICATION_REQUIRED=false
WORKFORCE_AUDIT_REPLICA_MAX_LAG_MINUTES=2880
# Zero disables the internal scheduler. A common production value is 1440.
WORKFORCE_AUDIT_SCHEDULED_BACKUP_MINUTES=0
WORKFORCE_AUDIT_DRILL_MAX_AGE_DAYS=30
WORKFORCE_AUDIT_SCHEDULER_TICK_SECONDS=60
# Enable file-lease only when all application processes share a filesystem with atomic mkdir/rename semantics.
WORKFORCE_AUDIT_COORDINATION_MODE=disabled
WORKFORCE_AUDIT_COORDINATION_DIR=.runtime-data/workforce-audit-coordination
WORKFORCE_AUDIT_FENCED_DATA_DIR=.runtime-data/workforce-audit-fenced
WORKFORCE_AUDIT_FENCED_VERSIONS=5
# Set a unique stable identifier per running process/container when coordination is enabled.
# WORKFORCE_AUDIT_INSTANCE_ID=basitclaw-node-1
WORKFORCE_AUDIT_LEASE_MS=30000
WORKFORCE_AUDIT_ACQUIRE_TIMEOUT_MS=1000
WORKFORCE_AUDIT_LEASE_RETRY_MS=20
AUDIT_PROVIDER_REVIEW_MAX_AGE_DAYS=365
# Authentication modes: api-key, oidc, hybrid. Hybrid supports controlled migration; never send both credentials in one request.
WORKFORCE_AUDIT_AUTH_MODE=api-key
# Plaintext apiKey records are accepted only outside production for migration compatibility.
WORKFORCE_AUDIT_API_KEYS=[{"apiKey":"local-development-key","subject":"local-admin","tenantId":"tenant-demo","role":"compliance_admin"}]
# Production records use keyId, salt, scrypt secretHash, lifecycle status, and optional activation/expiry windows.
# Generate one with: npm run credential:generate -- admin-2026-q3 audit-admin tenant-demo compliance_admin 2026-10-31T00:00:00Z
WORKFORCE_AUDIT_CREDENTIAL_WARNING_DAYS=14
# OIDC resource-server configuration. Issuer and JWKS must use HTTPS; browser authorization-code login is outside this service.
# WORKFORCE_AUDIT_OIDC_ISSUER=https://identity.example.com/tenant
# WORKFORCE_AUDIT_OIDC_AUDIENCE=workforce-audit-api
# WORKFORCE_AUDIT_OIDC_JWKS_URI=https://identity.example.com/tenant/.well-known/jwks.json
# Map each exact identity-provider group to one workforce-audit role. Multiple different mapped roles fail closed.
# WORKFORCE_AUDIT_OIDC_GROUP_ROLE_MAP={"audit-viewers":"audit_viewer","auditors":"auditor","audit-managers":"audit_manager","compliance-admins":"compliance_admin"}
WORKFORCE_AUDIT_OIDC_TENANT_CLAIM=tenant_id
WORKFORCE_AUDIT_OIDC_GROUPS_CLAIM=groups
# Production requires a tenant allowlist unless allow-any-tenant is explicitly approved.
# WORKFORCE_AUDIT_OIDC_ALLOWED_TENANTS=tenant-demo,tenant-acme
WORKFORCE_AUDIT_OIDC_ALLOW_ANY_TENANT=false
WORKFORCE_AUDIT_OIDC_ALLOWED_ALGORITHMS=RS256
# Optional step-up requirements. Values are comma-separated exact acr/amr claims.
WORKFORCE_AUDIT_OIDC_REQUIRED_ACR=
WORKFORCE_AUDIT_OIDC_REQUIRED_AMR=
WORKFORCE_AUDIT_OIDC_CLOCK_SKEW_SECONDS=60
WORKFORCE_AUDIT_OIDC_MAX_TOKEN_LIFETIME_SECONDS=3600
WORKFORCE_AUDIT_OIDC_JWKS_CACHE_SECONDS=900
WORKFORCE_AUDIT_OIDC_JWKS_STALE_SECONDS=3600
WORKFORCE_AUDIT_OIDC_JWKS_TIMEOUT_MS=5000
WORKFORCE_AUDIT_OIDC_REFRESH_SECONDS=300
WORKFORCE_AUDIT_OIDC_ALLOW_PRIVATE_JWKS=false
# OIDC-only production defaults to fail startup when JWKS warm-up fails. Set explicitly only after risk review.
# WORKFORCE_AUDIT_OIDC_STARTUP_REQUIRED=true
# Optional offline/public-key configuration for controlled tests or isolated deployments.
# WORKFORCE_AUDIT_OIDC_STATIC_JWKS={"keys":[{"kty":"RSA","kid":"example","use":"sig","alg":"RS256","n":"...","e":"AQAB"}]}
# Modes: memory, shared-file, disabled. Shared-file is required by default for coordinated production deployments.
WORKFORCE_AUDIT_RATE_LIMIT_MODE=memory
WORKFORCE_AUDIT_RATE_LIMIT_DIR=.runtime-data/workforce-audit-rate-limits
WORKFORCE_AUDIT_RATE_LIMIT_MAX_BUCKETS=100000
WORKFORCE_AUDIT_RATE_LIMIT_CLEANUP_INTERVAL_MS=300000
WORKFORCE_AUDIT_DISTRIBUTED_RATE_LIMIT_REQUIRED=false
WORKFORCE_AUDIT_RATE_LIMIT_BURST_PER_MINUTE=300
WORKFORCE_AUDIT_RATE_LIMIT_AUTH_FAILURES_PER_5_MINUTES=8
WORKFORCE_AUDIT_RATE_LIMIT_READ_PER_MINUTE=240
WORKFORCE_AUDIT_RATE_LIMIT_WRITE_PER_MINUTE=60
WORKFORCE_AUDIT_RATE_LIMIT_SENSITIVE_PER_15_MINUTES=10
# Keep zero unless the application is behind exactly this many trusted reverse proxies.
WORKFORCE_AUDIT_TRUST_PROXY_HOPS=0
WORKFORCE_AUDIT_SECURITY_EVENT_RETENTION=2000
# Use a stable secret so privacy-preserving client fingerprints remain comparable across restarts.
# WORKFORCE_AUDIT_SECURITY_EVENT_PEPPER=<long-random-secret>
# Shared security controls require a durable filesystem with reliable atomic mkdir/rename semantics.
WORKFORCE_AUDIT_SECURITY_CONTROL_LOCK_MS=10000
WORKFORCE_AUDIT_SECURITY_CONTROL_ACQUIRE_TIMEOUT_MS=2000
WORKFORCE_AUDIT_SECURITY_CONTROL_RETRY_MS=10
# Modes: disabled, shared-file. Required archives cannot be disabled.
WORKFORCE_AUDIT_SECURITY_ARCHIVE_MODE=disabled
WORKFORCE_AUDIT_SECURITY_ARCHIVE_REQUIRED=false
WORKFORCE_AUDIT_SECURITY_ARCHIVE_DIR=.runtime-data/workforce-audit-security-archive
# Preferred rotation-safe keyring. Keep historical keys until `npm run security-keys -- archive-can-retire <keyId>` reports safe.
# WORKFORCE_AUDIT_SECURITY_ARCHIVE_KEYS={"2026-q3":"<base64-32-byte-key>","2026-q2":"<previous-base64-32-byte-key>"}
# WORKFORCE_AUDIT_SECURITY_ARCHIVE_PRIMARY_KEY_ID=2026-q3
# Legacy single-key compatibility. Migrate to the keyring variables above.
WORKFORCE_AUDIT_SECURITY_ARCHIVE_KEY_ID=security-archive-v1
# WORKFORCE_AUDIT_SECURITY_ARCHIVE_KEY=<base64-32-byte-key>
WORKFORCE_AUDIT_SECURITY_ARCHIVE_RETENTION_DAYS=90
WORKFORCE_AUDIT_SECURITY_ARCHIVE_MAX_SEGMENT_BYTES=10000000
# Modes: disabled, webhook. Required delivery cannot be disabled.
WORKFORCE_AUDIT_SECURITY_ALERT_MODE=disabled
WORKFORCE_AUDIT_SECURITY_ALERT_REQUIRED=false
WORKFORCE_AUDIT_SECURITY_ALERT_AUTO_START=true
WORKFORCE_AUDIT_SECURITY_ALERT_OUTBOX_DIR=.runtime-data/workforce-audit-security-alerts
# Production webhooks must use HTTPS. Set private targets true only for an approved internal SIEM endpoint.
# WORKFORCE_AUDIT_SECURITY_ALERT_WEBHOOK_URL=https://siem.example.com/hooks/workforce-audit
# Preferred overlap keyring. Receivers should accept every configured key ID during rotation.
# WORKFORCE_AUDIT_SECURITY_ALERT_SIGNING_SECRETS={"2026-q3":"<long-random-secret>","2026-q2":"<previous-long-random-secret>"}
# WORKFORCE_AUDIT_SECURITY_ALERT_PRIMARY_SIGNING_KEY_ID=2026-q3
# Legacy single-key compatibility. Use at least 32 random bytes from a managed secret store.
# WORKFORCE_AUDIT_SECURITY_ALERT_SIGNING_SECRET=<long-random-secret>
WORKFORCE_AUDIT_SECURITY_ALERT_MIN_SEVERITY=high
# Empty means every event type at or above the severity threshold.
WORKFORCE_AUDIT_SECURITY_ALERT_TYPES=
WORKFORCE_AUDIT_SECURITY_ALERT_MAX_ATTEMPTS=8
WORKFORCE_AUDIT_SECURITY_ALERT_BASE_DELAY_MS=1000
WORKFORCE_AUDIT_SECURITY_ALERT_MAX_DELAY_MS=300000
WORKFORCE_AUDIT_SECURITY_ALERT_TIMEOUT_MS=5000
WORKFORCE_AUDIT_SECURITY_ALERT_POLL_INTERVAL_MS=5000
WORKFORCE_AUDIT_SECURITY_ALERT_BATCH_SIZE=25
WORKFORCE_AUDIT_SECURITY_ALERT_INFLIGHT_LEASE_MS=60000
WORKFORCE_AUDIT_SECURITY_ALERT_DELIVERED_RETENTION=10000
WORKFORCE_AUDIT_SECURITY_ALERT_DEAD_LETTER_RETENTION=2000
WORKFORCE_AUDIT_SECURITY_ALERT_ALLOW_HTTP=false
WORKFORCE_AUDIT_SECURITY_ALERT_ALLOW_PRIVATE_TARGETS=false
# JSON object mapping key IDs to base64-encoded 32-byte keys. Set this in production.
# WORKFORCE_AUDIT_ENCRYPTION_KEYS={"2026-q3":"<base64-32-byte-key>"}
# WORKFORCE_AUDIT_PRIMARY_KEY_ID=2026-q3
