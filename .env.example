PORT=3000
NODE_ENV=development
WORKFORCE_AUDIT_DATA_MODE=encrypted-file
WORKFORCE_AUDIT_DATA_DIR=.runtime-data/workforce-audit
WORKFORCE_AUDIT_BACKUP_DIR=.runtime-data/workforce-audit-backups
WORKFORCE_AUDIT_BACKUP_RETENTION=30
# Set this to a separately mounted durable volume in production.
# WORKFORCE_AUDIT_REPLICA_DIR=/mnt/off-host/workforce-audit-replicas
WORKFORCE_AUDIT_REPLICA_RETENTION=90
WORKFORCE_AUDIT_REPLICATION_REQUIRED=false
WORKFORCE_AUDIT_REPLICA_MAX_LAG_MINUTES=2880
# Zero disables the internal scheduler. A common production value is 1440.
WORKFORCE_AUDIT_SCHEDULED_BACKUP_MINUTES=0
WORKFORCE_AUDIT_DRILL_MAX_AGE_DAYS=30
WORKFORCE_AUDIT_SCHEDULER_TICK_SECONDS=60
# Enable file-lease only when all application processes share a filesystem with atomic mkdir/rename semantics.
WORKFORCE_AUDIT_COORDINATION_MODE=disabled
WORKFORCE_AUDIT_COORDINATION_DIR=.runtime-data/workforce-audit-coordination
WORKFORCE_AUDIT_FENCED_DATA_DIR=.runtime-data/workforce-audit-fenced
WORKFORCE_AUDIT_FENCED_VERSIONS=5
# Set a unique stable identifier per running process/container when coordination is enabled.
# WORKFORCE_AUDIT_INSTANCE_ID=basitclaw-node-1
WORKFORCE_AUDIT_LEASE_MS=30000
WORKFORCE_AUDIT_ACQUIRE_TIMEOUT_MS=1000
WORKFORCE_AUDIT_LEASE_RETRY_MS=20
AUDIT_PROVIDER_REVIEW_MAX_AGE_DAYS=365
# Plaintext apiKey records are accepted only outside production for migration compatibility.
WORKFORCE_AUDIT_API_KEYS=[{"apiKey":"local-development-key","subject":"local-admin","tenantId":"tenant-demo","role":"compliance_admin"}]
# Production records use keyId, salt, scrypt secretHash, lifecycle status, and optional activation/expiry windows.
# Generate one with: npm run credential:generate -- admin-2026-q3 audit-admin tenant-demo compliance_admin 2026-10-31T00:00:00Z
WORKFORCE_AUDIT_CREDENTIAL_WARNING_DAYS=14
# Modes: memory, shared-file, disabled. Shared-file is required by default for coordinated production deployments.
WORKFORCE_AUDIT_RATE_LIMIT_MODE=memory
WORKFORCE_AUDIT_RATE_LIMIT_DIR=.runtime-data/workforce-audit-rate-limits
WORKFORCE_AUDIT_RATE_LIMIT_MAX_BUCKETS=100000
WORKFORCE_AUDIT_RATE_LIMIT_CLEANUP_INTERVAL_MS=300000
WORKFORCE_AUDIT_DISTRIBUTED_RATE_LIMIT_REQUIRED=false
WORKFORCE_AUDIT_RATE_LIMIT_BURST_PER_MINUTE=300
WORKFORCE_AUDIT_RATE_LIMIT_AUTH_FAILURES_PER_5_MINUTES=8
WORKFORCE_AUDIT_RATE_LIMIT_READ_PER_MINUTE=240
WORKFORCE_AUDIT_RATE_LIMIT_WRITE_PER_MINUTE=60
WORKFORCE_AUDIT_RATE_LIMIT_SENSITIVE_PER_15_MINUTES=10
# Keep zero unless the application is behind exactly this many trusted reverse proxies.
WORKFORCE_AUDIT_TRUST_PROXY_HOPS=0
WORKFORCE_AUDIT_SECURITY_EVENT_RETENTION=2000
# Use a stable secret so privacy-preserving client fingerprints remain comparable across restarts.
# WORKFORCE_AUDIT_SECURITY_EVENT_PEPPER=<long-random-secret>
# Shared security controls require a durable filesystem with reliable atomic mkdir/rename semantics.
WORKFORCE_AUDIT_SECURITY_CONTROL_LOCK_MS=10000
WORKFORCE_AUDIT_SECURITY_CONTROL_ACQUIRE_TIMEOUT_MS=2000
WORKFORCE_AUDIT_SECURITY_CONTROL_RETRY_MS=10
# Modes: disabled, shared-file. Required archives cannot be disabled.
WORKFORCE_AUDIT_SECURITY_ARCHIVE_MODE=disabled
WORKFORCE_AUDIT_SECURITY_ARCHIVE_REQUIRED=false
WORKFORCE_AUDIT_SECURITY_ARCHIVE_DIR=.runtime-data/workforce-audit-security-archive
WORKFORCE_AUDIT_SECURITY_ARCHIVE_KEY_ID=security-archive-v1
# Base64-encoded 32-byte key. Keep it in a managed secret store in production.
# WORKFORCE_AUDIT_SECURITY_ARCHIVE_KEY=<base64-32-byte-key>
WORKFORCE_AUDIT_SECURITY_ARCHIVE_RETENTION_DAYS=90
WORKFORCE_AUDIT_SECURITY_ARCHIVE_MAX_SEGMENT_BYTES=10000000
# JSON object mapping key IDs to base64-encoded 32-byte keys. Set this in production.
# WORKFORCE_AUDIT_ENCRYPTION_KEYS={"2026-q3":"<base64-32-byte-key>"}
# WORKFORCE_AUDIT_PRIMARY_KEY_ID=2026-q3
