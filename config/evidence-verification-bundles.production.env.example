# Portable verification-bundle production overlay.
# Replace every placeholder through the approved secret manager before deployment.
NODE_ENV=production
WORKFORCE_AUDIT_EVIDENCE_BUNDLE_MODE=signed
WORKFORCE_AUDIT_EVIDENCE_BUNDLE_REQUIRE_TIME_QUORUM=true
WORKFORCE_AUDIT_EVIDENCE_BUNDLE_MAX_AGE_DAYS=30
WORKFORCE_AUDIT_EVIDENCE_BUNDLE_PRIMARY_SIGNING_KEY_ID=2026-q3
# Dedicated export-signing keys. Do not reuse evidence, preservation, notary, TLS or JWT keys.
# JSON-escape PEM newlines as \n. Ed25519 is recommended; RSA-PSS-SHA256 requires RSA 2048 bits or stronger.
WORKFORCE_AUDIT_EVIDENCE_BUNDLE_SIGNING_KEYS={"2026-q3":{"algorithm":"ed25519","privateKeyPem":"-----BEGIN PRIVATE KEY-----\n<replace-with-ed25519-private-key-from-approved-secret-manager>\n-----END PRIVATE KEY-----\n"}}
# Require a dual-approved, short-lived JIT grant before preservation/proof export in production.
WORKFORCE_AUDIT_PRIVILEGED_ACCESS_MODE=enforce
WORKFORCE_AUDIT_PRIVILEGED_ACCESS_PROTECTED_PERMISSIONS=backup:restore,resilience:run,security:read,evidence:preserve
WORKFORCE_AUDIT_PRIVILEGED_ACCESS_APPROVALS_REQUIRED=2
WORKFORCE_AUDIT_PRIVILEGED_ACCESS_REQUIRED_AMR=mfa
WORKFORCE_AUDIT_PRIVILEGED_ACCESS_ALLOW_API_KEY=false
